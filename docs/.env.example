# Virtual Marketing Platform — environment template.
# Copy to backend/.env and fill in. NEVER commit real secrets.

# --- Core ---
ENVIRONMENT=development
# Secret for signing auth tokens. Set a long random string in production
# (rotating it invalidates all issued tokens).
SECRET_KEY=
# Local dev default (blank = backend uses ./dev.db). Production: Supabase
# Postgres connection string, e.g.
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- LLM / AI content (Phase 2) ---
# "mock" = offline, free, always works. "gemini" = Google AI Studio free tier
# (free key: https://aistudio.google.com/api-keys — no credit card needed).
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic Claude (optional paid upgrade path) ---
ANTHROPIC_API_KEY=

# --- WhatsApp Business Cloud API + Meta Lead Ads (Phase 4) ---
# All optional. Every webhook answers 503 until META_APP_SECRET is set.
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app credentials. META_VERIFY_TOKEN is the random string you also type
# into the Meta App webhook settings; META_APP_SECRET verifies
# X-Hub-Signature-256; META_PAGE_ACCESS_TOKEN fetches the full Lead Ad answers.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
# Per-workspace routing ids (Meta Page id / Cloud API phone number id) are set
# in the app under Settings -> Integrations, not as env vars.
