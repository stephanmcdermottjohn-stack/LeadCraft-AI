# Virtual Marketing Platform — environment template.
# Copy to backend/.env and fill in. NEVER commit real secrets.

# --- Core ---
ENVIRONMENT=development
# Local dev default (blank = backend uses ./dev.db). Production: Supabase
# Postgres connection string, e.g.
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Anthropic Claude (Phase 2: content generation) ---
# https://docs.anthropic.com/ — key starts with sk-ant-
ANTHROPIC_API_KEY=

# --- WhatsApp Business Cloud API (Phase 4; OFFICIAL Meta product only) ---
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Random string you set in the Meta App webhook config for verification.
META_VERIFY_TOKEN=
